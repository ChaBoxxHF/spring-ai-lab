#####################################################################
# Commandes
#####################################################################

### Créer une commande (lignes fusionnées)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "clientId": {{clientId}},
  "lines": [
    { "productId": {{keyboardId}}, "quantity": 2 },
    { "productId": {{mouseId}}, "quantity": 1 },
    { "productId": {{keyboardId}}, "quantity": 3 }
  ]
}

> {%
    const order = response.body;
    client.test("répond 201 Created", function () {
        client.assert(response.status === 201, "statut " + response.status);
    });
    client.test("renvoie l'en-tête Location", function () {
        client.assert(response.headers.valueOf("Location").endsWith("/api/orders/" + order.id));
    });
    client.test("la commande est créée au statut DRAFT pour le client", function () {
        client.assert(order.status === "DRAFT", order.status);
        client.assert(Number(order.clientId) === Number(client.global.get("clientId")));
    });
    client.test("fusionne les lignes d'un même produit en conservant l'ordre", function () {
        client.assert(order.lines.length === 2, "lignes : " + order.lines.length);
        client.assert(Number(order.lines[0].productId) === Number(client.global.get("keyboardId")));
        client.assert(order.lines[0].quantity === 5);
        client.assert(Number(order.lines[1].productId) === Number(client.global.get("mouseId")));
        client.assert(order.lines[1].quantity === 1);
    });
    client.test("mémorise le prix unitaire du produit", function () {
        client.assert(order.lines[0].unitPrice === 19.99);
        client.assert(order.lines[1].unitPrice === 5.5);
    });
    client.test("calcule les totaux de ligne et de commande", function () {
        client.assert(order.lines[0].lineTotal === 99.95, String(order.lines[0].lineTotal));
        client.assert(order.lines[1].lineTotal === 5.5, String(order.lines[1].lineTotal));
        client.assert(order.total === 105.45, String(order.total));
    });
    client.global.set("orderId", order.id);
%}

### Lire une commande
GET {{baseUrl}}/api/orders/{{orderId}}

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("renvoie la commande demandée", function () {
        client.assert(Number(response.body.id) === Number(client.global.get("orderId")));
        client.assert(response.body.status === "DRAFT");
        client.assert(response.body.lines.length === 2);
        client.assert(response.body.total === 105.45);
    });
%}

### Lister les commandes
GET {{baseUrl}}/api/orders

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("contient la commande créée", function () {
        client.assert(response.body.some(o => Number(o.id) === Number(client.global.get("orderId"))));
    });
%}

