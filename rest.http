%}

### Lister les produits
GET {{baseUrl}}/api/products

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("contient les produits créés", function () {
        const ids = response.body.map(p => Number(p.id));
        ["keyboardId", "mouseId", "inactiveProductId"].forEach(name =>
            client.assert(ids.includes(Number(client.global.get(name))), name + " absent"));
    });
%}

