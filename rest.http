    client.global.set("inactiveProductId", response.body.id);
%}

### Lire un produit
GET {{baseUrl}}/api/products/{{keyboardId}}

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("renvoie le produit demandé", function () {
        client.assert(Number(response.body.id) === Number(client.global.get("keyboardId")));
        client.assert(response.body.price === 19.99);
