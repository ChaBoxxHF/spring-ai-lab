### Tests d'API de bout en bout (client HTTP IntelliJ).
### Mêmes scénarios que la collection Bruno (bruno-api/). À exécuter dans l'ordre, de haut en bas :
### les commandes réutilisent le client et les produits créés plus haut.

@baseUrl = http://localhost:8080
@unknownId = 999999999

#####################################################################
# Clients
#####################################################################

### Créer un client
< {%
    // Email unique à chaque exécution, en casse mixte pour vérifier la mise en minuscules
    const email = "Jean.Dupont." + Date.now() + "@Example.COM";
    client.global.set("clientEmail", email);
    client.global.set("clientEmailUpper", email.toUpperCase());
%}
POST {{baseUrl}}/api/clients
Content-Type: application/json

{
  "firstName": "Jean",
  "lastName": "Dupont",
  "email": "{{clientEmail}}"
}

> {%
    client.test("répond 201 Created", function () {
        client.assert(response.status === 201, "statut " + response.status);
    });
    client.test("renvoie l'en-tête Location", function () {
        client.assert(response.headers.valueOf("Location").endsWith("/api/clients/" + response.body.id));
    });
    client.test("renvoie le client créé", function () {
        client.assert(typeof response.body.id === "number");
        client.assert(response.body.firstName === "Jean");
        client.assert(response.body.lastName === "Dupont");
    });
    client.test("enregistre l'email en minuscules", function () {
        client.assert(response.body.email === client.global.get("clientEmail").toLowerCase(), response.body.email);
    });
    client.global.set("clientId", response.body.id);
%}

### Lire un client
GET {{baseUrl}}/api/clients/{{clientId}}

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("renvoie le client demandé", function () {
        client.assert(Number(response.body.id) === Number(client.global.get("clientId")));
        client.assert(response.body.email === client.global.get("clientEmail").toLowerCase());
    });
%}

### Lister les clients
GET {{baseUrl}}/api/clients

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("contient le client créé", function () {
        client.assert(response.body.some(c => Number(c.id) === Number(client.global.get("clientId"))));
    });
%}

### Créer un client - email déjà utilisé (casse différente)
POST {{baseUrl}}/api/clients
Content-Type: application/json

{
  "firstName": "Jeanne",
  "lastName": "Durand",
  "email": "{{clientEmailUpper}}"
}

> {%
    client.test("répond 409 Conflict", function () {
        client.assert(response.status === 409, "statut " + response.status);
    });
%}

### Créer un client - requête invalide
POST {{baseUrl}}/api/clients
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Dupont",
  "email": "pas-un-email"
}

> {%
    client.test("répond 400 Bad Request", function () {
        client.assert(response.status === 400, "statut " + response.status);
    });
    client.test("détaille les champs en erreur", function () {
        const errors = response.body.errors;
        client.assert("firstName" in errors && "email" in errors && !("lastName" in errors), JSON.stringify(errors));
    });
%}

### Lire un client - inexistant
GET {{baseUrl}}/api/clients/{{unknownId}}

> {%
    client.test("répond 404 Not Found", function () {
        client.assert(response.status === 404, "statut " + response.status);
    });
%}

#####################################################################
# Produits
#####################################################################

### Créer un produit actif (clavier)
< {%
    // Références uniques à chaque exécution
    client.global.set("productSuffix", String(Date.now()));
%}
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "reference": "CLAVIER-{{productSuffix}}",
  "name": "Clavier",
  "price": 19.99,
  "active": true
}

> {%
    client.test("répond 201 Created", function () {
        client.assert(response.status === 201, "statut " + response.status);
    });
    client.test("renvoie l'en-tête Location", function () {
        client.assert(response.headers.valueOf("Location").endsWith("/api/products/" + response.body.id));
    });
    client.test("renvoie le produit créé", function () {
        client.assert(response.body.reference === "CLAVIER-" + client.global.get("productSuffix"));
        client.assert(response.body.name === "Clavier");
        client.assert(response.body.price === 19.99);
        client.assert(response.body.active === true);
    });
    client.global.set("keyboardId", response.body.id);
%}

