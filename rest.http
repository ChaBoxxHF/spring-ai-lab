### Confirmer une commande (DRAFT -> CONFIRMED)
PATCH {{baseUrl}}/api/orders/{{orderId}}/status
Content-Type: application/json

{
  "status": "CONFIRMED"
}

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("la commande est confirmée", function () {
        client.assert(response.body.status === "CONFIRMED");
    });
%}

### Transition interdite (CONFIRMED -> DRAFT)
PATCH {{baseUrl}}/api/orders/{{orderId}}/status
Content-Type: application/json

{
  "status": "DRAFT"
}

> {%
    client.test("répond 409 Conflict", function () {
        client.assert(response.status === 409, "statut " + response.status);
    });
%}

### Annuler une commande confirmée (CONFIRMED -> CANCELLED)
PATCH {{baseUrl}}/api/orders/{{orderId}}/status
Content-Type: application/json

{
  "status": "CANCELLED"
}

> {%
    client.test("répond 200 OK", function () {
        client.assert(response.status === 200, "statut " + response.status);
    });
    client.test("la commande est annulée", function () {
        client.assert(response.body.status === "CANCELLED");
    });
%}

### Transition interdite (CANCELLED -> CONFIRMED)
PATCH {{baseUrl}}/api/orders/{{orderId}}/status
Content-Type: application/json

{
  "status": "CONFIRMED"
}

> {%
    client.test("répond 409 Conflict", function () {
        client.assert(response.status === 409, "statut " + response.status);
    });
