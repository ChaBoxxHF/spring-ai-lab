### Créer une seconde commande
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "clientId": {{clientId}},
  "lines": [
    { "productId": {{mouseId}}, "quantity": 4 }
  ]
}

> {%
    client.test("répond 201 Created", function () {
        client.assert(response.status === 201, "statut " + response.status);
    });
    client.test("la commande est au statut DRAFT", function () {
        client.assert(response.body.status === "DRAFT");
        client.assert(response.body.total === 22, String(response.body.total));
    });
    client.global.set("draftOrderId", response.body.id);
%}

