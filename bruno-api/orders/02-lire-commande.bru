meta {
  name: Lire une commande
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/orders/{{orderId}}
  body: none
  auth: none
}

tests {
  test("répond 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("renvoie la commande demandée", function() {
    expect(res.body.id).to.equal(bru.getVar("orderId"));
    expect(res.body.status).to.equal("DRAFT");
    expect(res.body.lines).to.have.lengthOf(2);
    expect(res.body.total).to.equal(105.45);
  });
}
