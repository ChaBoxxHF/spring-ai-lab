meta {
  name: Annuler une commande confirmée (CONFIRMED -> CANCELLED)
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/orders/{{orderId}}/status
  body: json
  auth: none
}

body:json {
  {
    "status": "CANCELLED"
  }
}

tests {
  test("répond 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("la commande est annulée", function() {
    expect(res.body.status).to.equal("CANCELLED");
  });
}
