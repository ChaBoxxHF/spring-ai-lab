meta {
  name: Créer une commande - quantité négative
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: none
}

body:json {
  {
    "clientId": {{clientId}},
    "lines": [
      { "productId": {{keyboardId}}, "quantity": -2 }
    ]
  }
}

tests {
  test("répond 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("signale la quantité en erreur", function() {
    expect(res.body.errors).to.have.property("lines[0].quantity");
  });
}
