meta {
  name: Créer un produit - prix à trois décimales
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: none
}

body:json {
  {
    "reference": "DECIMALES-{{productSuffix}}",
    "name": "Produit trop précis",
    "price": 9.999,
    "active": true
  }
}

tests {
  test("répond 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("signale le prix en erreur", function() {
    expect(res.body.errors).to.have.property("price");
  });
}
